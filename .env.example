# ===================================
# Server Configuration
# ===================================

# Server port (default: 3005)
PORT=3005

# Environment: development or production
ENV=development

# Directory where cookie files are stored (default: cookies)
COOKIES_DIR=cookies

# ===================================
# CORS Configuration
# ===================================

# Allowed origins for CORS (comma-separated domains)
# Examples:
#   ALLOWED_ORIGINS=https://example.com
#   ALLOWED_ORIGINS=https://example.com,https://app.example.com
#   ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
#
# Leave empty in development for default localhost access
# MUST set in production or all origins will be blocked!
ALLOWED_ORIGINS=

# ===================================
# Cookie-based Authentication (Optional)
# ===================================
# Recommended: Use cookie files (cookies/twitter.json, etc.)
# These env vars are fallbacks only

# Twitter (if cookies/twitter.json doesn't exist)
# TWITTER_AUTH_TOKEN=
# TWITTER_CSRF_TOKEN=

# Facebook (if cookies/facebook.json doesn't exist)
# FACEBOOK_C_USER=
# FACEBOOK_XS=

# Instagram (if cookies/instagram.json doesn't exist)
# INSTAGRAM_SESSIONID=

# ===================================
# Proxy Configuration (Optional)
# ===================================
# Format proxy (auth opsional):
#   http://172.20.20.102:8888
#   http://user:pass@p.webshare.io:80
#   socks5://127.0.0.1:1080
#   172.20.20.102:8888            (skema http diasumsikan)
#
# Prioritas per request:
#   1. PROXY_<PROVIDER>  -> proxy khusus provider itu
#   2. PROXY_GLOBAL      -> dipakai semua provider yang tidak punya proxy khusus
#   3. (kosong)          -> koneksi langsung tanpa proxy
#
# Nama provider yang dikenal: DANBOORU, ZEROCHAN, INSTAGRAM, PIXIV, TWITTER,
# FACEBOOK, PINTEREST, GENERIC, PROXY (endpoint /proxy/image untuk domain tak dikenal).

# Proxy global (fallback untuk semua provider)
# PROXY_GLOBAL=http://172.20.20.102:8888

# Proxy per-provider (menimpa PROXY_GLOBAL untuk provider bersangkutan)
# PROXY_DANBOORU=http://172.20.20.102:8888
# PROXY_ZEROCHAN=http://172.20.20.102:8888
# PROXY_INSTAGRAM=http://user:pass@p.webshare.io:80
# PROXY_PIXIV=http://172.20.20.102:8888
# PROXY_TWITTER=
# PROXY_FACEBOOK=
# PROXY_PINTEREST=
# PROXY_GENERIC=

# ===================================
# Zerochan Configuration (Optional)
# ===================================
# Zerochan mewajibkan User-Agent bernama "NamaProyek - Username".
# Default: "go-social-dls - ilhmlnaa". Ganti dengan username Zerochan-mu.
# ZEROCHAN_USER_AGENT=go-social-dls - YourZerochanUsername

# ===================================
# Advanced Configuration (Optional)
# ===================================

# REQUEST_TIMEOUT=30
# MAX_CONCURRENT_REQUESTS=100
# DEBUG=false
# RATE_LIMIT=60
